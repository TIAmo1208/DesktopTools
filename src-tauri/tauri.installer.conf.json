{
    "$schema": "https://schema.tauri.app/config/2",
    "bundle": {
        "active": true,
        "targets": ["nsis"],
        "publisher": "Desktop Tools Project",
        "shortDescription": "Windows 桌面内容工作区",
        "icon": ["icons/icon.ico"],
        "license": "GPL-3.0-or-later",
        "licenseFile": "../resources/许可证/GPL-3.0.txt",
        "resources": {
            "../resources/许可证/": "许可证/",
            "../resources/Lucide许可证.txt": "许可证/Lucide许可证.txt",
            "../build/licenses/第三方许可证.txt": "许可证/第三方许可证.txt"
        },
        "windows": {
            "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
            "nsis": {
                "template": "installer/installer.nsi",
                "installMode": "currentUser",
                "languages": ["SimpChinese"],
                "installerHooks": "installer/hooks.nsh"
            }
        }
    }
}
